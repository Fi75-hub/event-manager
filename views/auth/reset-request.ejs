<%- include('../partials/header', { title: roleLabel + ' Password Reset' }) %>

<section class="card">
    <h1><%= roleLabel %> Password Reset</h1>
    <p class="muted">Enter the email you used for this account.</p>

    <% if (info) { %>
        <div class="alert alert--success">
            <p>
                If the details are correct, you will be taken to the next step to reset your password.</p>
        </div>
    <% } %>

    <% if (errors && errors.length > 0) { %>
        <div class="alert alert--danger">
            <ul>
                <% errors.forEach(function (e) { %>
                    <li><%= e %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form class="form" method="post" action="/auth/<%= role %>/reset-request">
        <label class="label">
            Email
            <input class="input" type="email" name="email" value="<%= values.email %>" required />
        </label>

<div class="form__actions">
            <button class="btn" type="submit">Continue</button>
            <a class="btn btn--ghost" href="/auth/<%= role %>/login">Back to login</a>
        </div>
    </form>
</section>

<%- include('../partials/footer') %>
