<%- include('../partials/header', { title: roleLabel + ' Login' }) %>

<section class="card">
    <h1><%= roleLabel %> Login</h1>
    <p class="muted">Sign in to continue.</p>

    <% if (errors && errors.length > 0) { %>
        <div class="alert alert--danger">
            <ul>
                <% errors.forEach(function (e) { %>
                    <li><%= e %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form class="form" method="post" action="/auth/<%= role %>/login">
        <label class="label">
            Email
            <input class="input" type="email" name="email" value="<%= values.email %>" required />
        </label>

        <label class="label">
            Password
            <input class="input" type="password" name="password" required />
        </label>

        <div class="form__actions">
            <button class="btn" type="submit">Login</button>
            <a class="btn btn--ghost" href="/auth/<%= role %>/register">Create account</a>
            <a class="btn btn--ghost" href="/auth/<%= role %>/reset-request">Forgot password?</a>
            <a class="btn btn--ghost" href="/">Back</a>
        </div>
    </form>
</section>

<%- include('../partials/footer') %>
